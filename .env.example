# ============================================================================
# AI Resume Builder - Environment Configuration
# ============================================================================

# Optional: Google Gemini API Key for LLM-assisted resume tailoring
# If left empty, the tailoring engine runs entirely in local deterministic rule-based mode
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Django Backend Configuration
DJANGO_SECRET_KEY=django-insecure-dev-local-secret-key-replace-in-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Frontend API Endpoint
NEXT_PUBLIC_API_URL=http://localhost:8000
