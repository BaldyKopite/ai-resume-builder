# Optional: Set your Gemini API key for AI-enhanced resume tailoring and parsing.
# When omitted, the application automatically runs in deterministic NLP + rule-based tailoring mode,
# ensuring full functionality, zero data retention, and strict no-fabrication compliance offline.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Django settings
DJANGO_SECRET_KEY=dev-secret-key-change-in-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,testserver
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
